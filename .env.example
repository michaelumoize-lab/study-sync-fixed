# ==============================================================================
# StudySync — Environment Variables Template
# Copy this file to .env and populate with your credentials.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Database (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Direct connection string for Neon / PostgreSQL
DATABASE_URL="postgresql://user:password@ep-sample-pool.us-east-2.aws.neon.tech/studysync?sslmode=require"

# ------------------------------------------------------------------------------
# Authentication (Better Auth)
# ------------------------------------------------------------------------------
# Generate a secure 32+ character random string (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET="your-better-auth-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"

# Optional: Google OAuth Provider Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ------------------------------------------------------------------------------
# AI & LLM Inference (Groq)
# ------------------------------------------------------------------------------
# API key from https://console.groq.com (Llama 3.3 70B Versatile)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# ------------------------------------------------------------------------------
# Rate Limiting & Caching (Upstash Redis)
# ------------------------------------------------------------------------------
# Credentials from https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://your-database-name.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token_here"

# ------------------------------------------------------------------------------
# File & Media Storage (Vercel Blob)
# ------------------------------------------------------------------------------
# Token from Vercel Storage dashboard
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_token_here"

# ------------------------------------------------------------------------------
# Email Delivery (Resend)
# ------------------------------------------------------------------------------
# API key from https://resend.com
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="StudySync <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# Product Analytics (PostHog - Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY="phc_your_posthog_key_here"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ------------------------------------------------------------------------------
# System & Maintenance (Optional)
# ------------------------------------------------------------------------------
MAINTENANCE_MESSAGE="StudySync is currently undergoing scheduled maintenance."
MAINTENANCE_ESTIMATED_TIME="1 hour"
MAINTENANCE_CONTACT_EMAIL="support@studysync.website"
